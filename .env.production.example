# Reference only. Set actual values in the hosting provider's Environment UI.
NODE_ENV=production
WORDSMITH_DEMO_MODE=false
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/wordsmith
NOTION_TOKEN=REPLACE_IN_HOSTING_ONLY
ADMIN_PASSWORD_HASH=GENERATE_WITH_NPM_RUN_ADMIN_CREDENTIALS
SESSION_SECRET=GENERATE_WITH_NPM_RUN_ADMIN_CREDENTIALS
# Render supplies RENDER_EXTERNAL_URL; PUBLIC_ORIGIN can override it for a custom domain.
# PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# First deploy only: authenticated setup captures the Notion handshake.
NOTION_WEBHOOK_SETUP=true
# After verification, set the captured token and disable setup mode.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
